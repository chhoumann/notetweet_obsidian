{
	"name": "notetweet",
	"version": "0.7.0",
	"description": "Post tweets and threads to X (Twitter) directly from your notes.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "pnpm run typecheck && node esbuild.config.mjs production",
		"typecheck": "tsc --noEmit",
		"lint": "eslint . --max-warnings=0",
		"test": "vitest run --passWithNoTests",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
		"test:e2e": "pnpm run build && pnpm run typecheck:e2e && vitest run --config vitest.e2e.config.ts",
		"obsidian:e2e": "obsidian-e2e run",
		"provision:e2e-vault": "obsidian-e2e provision",
		"start:e2e-obsidian": "obsidian-e2e start",
		"stop:e2e-obsidian": "obsidian-e2e stop"
	},
	"keywords": [
		"obsidian",
		"twitter",
		"x",
		"plugin"
	],
	"author": "Christian Bager Bach Houmann",
	"license": "MIT",
	"packageManager": "pnpm@12.14.0",
	"engines": {
		"node": ">=24"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/chhoumann/notetweet_obsidian.git"
	},
	"devDependencies": {
		"@types/node": "24.19.2",
		"@vitest/coverage-v8": "5.0.5",
		"esbuild": "0.28.2",
		"eslint": "10.13.0",
		"eslint-plugin-obsidianmd": "0.4.2",
		"globals": "17.13.0",
		"obsidian": "1.14.4",
		"obsidian-e2e": "0.14.0",
		"obsidian-test-kit": "0.1.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.71.2",
		"vitest": "5.0.5"
	},
	"dependencies": {
		"twitter-text": "3.1.0",
		"unicode-segmenter": "0.17.3"
	}
}
